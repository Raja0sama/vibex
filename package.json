{
  "name": "@vibex/vibex",
  "version": "0.3.0",
  "description": "Architecture diagrams and checkable documentation from your codebase: ERD, C4, API endpoints and lifecycle diagrams, plus a fact graph whose claims fail CI when the code moves. Imports OpenAPI, GraphQL SDL and Prisma. One standalone HTML file, zero dependencies, no server.",
  "keywords": [
    "diagram",
    "erd",
    "c4",
    "architecture",
    "openapi",
    "graphql",
    "prisma",
    "svg",
    "html",
    "cli",
    "claude-code",
    "skill",
    "docs",
    "documentation",
    "changelog",
    "lifecycle",
    "c4-model",
    "diagrams-as-code"
  ],
  "license": "MIT",
  "author": "Raja",
  "homepage": "https://github.com/Raja0sama/vibex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raja0sama/vibex.git"
  },
  "bugs": {
    "url": "https://github.com/Raja0sama/vibex/issues"
  },
  "type": "module",
  "bin": {
    "vibex": "bin/vibex.mjs"
  },
  "files": [
    "bin/",
    "renderers/",
    "importers/",
    "assets/",
    "schemas/",
    "examples/",
    "SKILL.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node bin/vibex.mjs demo out",
    "prepublishOnly": "npm test",
    "build:site": "node scripts/build-site.mjs"
  },
  "optionalDependencies": {
    "yaml": "^2.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
