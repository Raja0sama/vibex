{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": { "id": "claim.lifecycle", "title": "Insurance claim lifecycle" },
  "states": [
    { "id": "draft", "label": "Draft", "kind": "initial", "actor": "claimant", "description": "Being filled in" },
    { "id": "submitted", "label": "Submitted", "actor": "triage", "description": "Waiting for triage" },
    { "id": "needs_info", "label": "Needs info", "kind": "waiting", "actor": "claimant", "description": "Adjuster asked for documents" },
    { "id": "under_review", "label": "Under review", "actor": "adjuster", "description": "Adjuster assessing" },
    { "id": "escalated", "label": "Escalated", "actor": "senior adjuster", "description": "Above the adjuster's limit" },
    { "id": "fraud_check", "label": "Fraud check", "kind": "waiting", "actor": "fraud team", "description": "Flagged by the scoring model" },
    { "id": "approved", "label": "Approved", "actor": "finance", "description": "Payout authorised" },
    { "id": "partially_approved", "label": "Partially approved", "actor": "claimant", "description": "Some items covered" },
    { "id": "payment_pending", "label": "Payment pending", "kind": "waiting", "actor": "bank", "description": "Transfer in flight" },
    { "id": "payment_failed", "label": "Payment failed", "kind": "failure", "actor": "finance", "description": "Bank rejected the transfer" },
    { "id": "rejected", "label": "Rejected", "kind": "failure", "actor": "claimant", "description": "Not covered" },
    { "id": "appealed", "label": "Appealed", "actor": "appeals board", "description": "Claimant disputes the decision" },
    { "id": "paid", "label": "Paid", "kind": "terminal", "description": "Money received" },
    { "id": "withdrawn", "label": "Withdrawn", "kind": "terminal", "description": "Claimant gave up" },
    { "id": "closed", "label": "Closed", "kind": "terminal", "description": "Final rejection stands" }
  ],
  "transitions": [
    { "from": "draft", "to": "submitted", "event": "submit", "actor": "claimant", "guard": "all required fields", "action": "notify triage" },
    { "from": "draft", "to": "withdrawn", "event": "60 days idle", "actor": "system", "kind": "timeout" },
    { "from": "submitted", "to": "under_review", "event": "assign", "actor": "triage", "action": "pick adjuster" },
    { "from": "submitted", "to": "fraud_check", "event": "score > 0.8", "actor": "system", "kind": "auto" },
    { "from": "submitted", "to": "withdrawn", "event": "withdraw", "actor": "claimant" },
    { "from": "under_review", "to": "needs_info", "event": "request documents", "actor": "adjuster", "action": "email claimant" },
    { "from": "needs_info", "to": "under_review", "event": "upload documents", "actor": "claimant" },
    { "from": "needs_info", "to": "withdrawn", "event": "30 days silent", "actor": "system", "kind": "timeout" },
    { "from": "under_review", "to": "escalated", "event": "escalate", "actor": "adjuster", "guard": "amount > limit" },
    { "from": "under_review", "to": "approved", "event": "approve", "actor": "adjuster", "guard": "amount <= limit" },
    { "from": "under_review", "to": "partially_approved", "event": "approve some items", "actor": "adjuster" },
    { "from": "under_review", "to": "rejected", "event": "reject", "actor": "adjuster", "kind": "failure", "action": "send reason letter" },
    { "from": "escalated", "to": "approved", "event": "approve", "actor": "senior adjuster" },
    { "from": "escalated", "to": "rejected", "event": "reject", "actor": "senior adjuster", "kind": "failure" },
    { "from": "escalated", "to": "under_review", "event": "send back", "actor": "senior adjuster" },
    { "from": "fraud_check", "to": "under_review", "event": "cleared", "actor": "fraud team" },
    { "from": "fraud_check", "to": "rejected", "event": "fraud confirmed", "actor": "fraud team", "kind": "failure", "action": "report to regulator" },
    { "from": "partially_approved", "to": "payment_pending", "event": "accept offer", "actor": "claimant" },
    { "from": "partially_approved", "to": "appealed", "event": "appeal", "actor": "claimant", "guard": "within 14 days" },
    { "from": "approved", "to": "payment_pending", "event": "release funds", "actor": "finance", "action": "initiate transfer" },
    { "from": "payment_pending", "to": "paid", "event": "transfer settled", "actor": "bank", "kind": "auto" },
    { "from": "payment_pending", "to": "payment_failed", "event": "transfer rejected", "actor": "bank", "kind": "failure" },
    { "from": "payment_failed", "to": "payment_pending", "event": "retry transfer", "actor": "finance", "guard": "new bank details" },
    { "from": "rejected", "to": "appealed", "event": "appeal", "actor": "claimant", "guard": "within 14 days" },
    { "from": "rejected", "to": "closed", "event": "14 days pass", "actor": "system", "kind": "timeout" },
    { "from": "appealed", "to": "under_review", "event": "appeal upheld", "actor": "appeals board", "action": "reassign adjuster" },
    { "from": "appealed", "to": "closed", "event": "appeal denied", "actor": "appeals board", "kind": "failure" }
  ]
}
