  "cards": [
    {
      "title": "Conventions",
      "tone": "info",
      "items": [
        "All ids are uuid v7",
        "Money is integer cents, never float",
        "Timestamps are timestamptz in UTC",
        "Snapshot columns (`*_snapshot`, `unit_price_cents`) freeze a value at write time"
      ]
    },
    {
      "title": "Watch out",
      "tone": "warning",
      "items": [
        "`orders` is wide on purpose — money, lifecycle and provenance in one row",
        "`categories.parent_id` is self-referencing; guard against cycles in application code",
        "`product_categories`, `order_discounts` and `shipment_items` are composite-key join tables"
      ]
    }
  ]
