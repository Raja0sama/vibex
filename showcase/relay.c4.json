{
  "schema_version": 1,
  "diagram_type": "c4",
  "meta": {
    "id": "relay.c4",
    "title": "Relay \u2014 parcel network",
    "subtitle": "C4 level 2: the containers that move a parcel from a merchant to a doorstep",
    "level": "container",
    "scope": "Relay",
    "repository": {
      "url": "https://github.com/example/relay",
      "revision": "main"
    }
  },
  "elements": [
    {
      "id": "merchant",
      "kind": "person",
      "label": "Merchant",
      "description": "Books shipments and watches them until they land"
    },
    {
      "id": "recipient",
      "kind": "person",
      "label": "Recipient",
      "description": "Tracks a parcel and reschedules when they will not be in"
    },
    {
      "id": "courier",
      "kind": "person",
      "label": "Courier",
      "description": "Scans parcels at every handover and records delivery attempts"
    },
    {
      "id": "portal",
      "kind": "container",
      "label": "Merchant portal",
      "technology": "Next.js",
      "description": "Booking, labels, invoices and shipment history"
    },
    {
      "id": "tracking_web",
      "kind": "container",
      "label": "Tracking page",
      "technology": "React",
      "description": "The public page a recipient opens from an SMS. No login."
    },
    {
      "id": "handheld",
      "kind": "container",
      "label": "Courier handheld",
      "technology": "Kotlin / Android",
      "description": "Scans barcodes offline and syncs when it finds signal"
    },
    {
      "id": "api",
      "kind": "container",
      "label": "Shipment API",
      "technology": "Go",
      "description": "Booking, cancellation and the merchant-facing read model",
      "link": "relay.endpoints.html"
    },
    {
      "id": "scans",
      "kind": "container",
      "label": "Scan ingest",
      "technology": "Go",
      "description": "Accepts batched, out-of-order scans from handhelds and makes them idempotent"
    },
    {
      "id": "dispatch",
      "kind": "container",
      "label": "Dispatch",
      "technology": "Java / Spring",
      "description": "Owns parcel state and decides which route a parcel joins"
    },
    {
      "id": "routing",
      "kind": "container",
      "label": "Routing engine",
      "technology": "Python",
      "description": "Sequences stops for a van under time windows and vehicle capacity"
    },
    {
      "id": "notify",
      "kind": "container",
      "label": "Notifier",
      "technology": "Node.js",
      "description": "Sends the SMS and email a recipient actually reads"
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Relay DB",
      "technology": "PostgreSQL 15",
      "description": "Shipments, parcels, routes and every scan ever taken"
    },
    {
      "id": "events",
      "kind": "queue",
      "label": "Parcel events",
      "technology": "Kafka",
      "description": "parcel.scanned, parcel.delivered, parcel.attempt-failed"
    },
    {
      "id": "addressing",
      "kind": "system",
      "label": "Loqate",
      "external": true,
      "description": "Address validation and geocoding",
      "row": 7,
      "col": 0
    },
    {
      "id": "sms",
      "kind": "system",
      "label": "Twilio",
      "external": true,
      "description": "SMS delivery to recipients",
      "row": 7,
      "col": 2
    },
    {
      "id": "partners",
      "kind": "system",
      "label": "Partner carriers",
      "external": true,
      "description": "Final mile in postcodes Relay does not serve itself",
      "row": 7,
      "col": 1
    }
  ],
  "boundaries": [
    {
      "id": "relay",
      "kind": "system",
      "label": "Relay",
      "contains": [
        "portal",
        "tracking_web",
        "handheld",
        "core"
      ]
    },
    {
      "id": "core",
      "kind": "deployment",
      "label": "Core services",
      "contains": [
        "api",
        "scans",
        "dispatch",
        "routing",
        "notify",
        "db",
        "events"
      ]
    }
  ],
  "relationships": [
    {
      "from": "merchant",
      "to": "portal",
      "label": "Books shipments in",
      "technology": "HTTPS"
    },
    {
      "from": "recipient",
      "to": "tracking_web",
      "label": "Tracks a parcel on",
      "technology": "HTTPS"
    },
    {
      "from": "courier",
      "to": "handheld",
      "label": "Scans parcels with",
      "technology": "Bluetooth scanner"
    },
    {
      "from": "portal",
      "to": "api",
      "label": "Books and cancels via",
      "technology": "REST/JSON"
    },
    {
      "from": "tracking_web",
      "to": "api",
      "label": "Reads tracking history from",
      "technology": "REST/JSON"
    },
    {
      "from": "handheld",
      "to": "scans",
      "label": "Uploads scan batches to",
      "technology": "REST/JSON over mTLS"
    },
    {
      "from": "api",
      "to": "dispatch",
      "label": "Creates parcels in",
      "technology": "gRPC"
    },
    {
      "from": "api",
      "to": "addressing",
      "label": "Validates addresses with",
      "technology": "HTTPS"
    },
    {
      "from": "scans",
      "to": "events",
      "label": "Publishes",
      "technology": "Kafka",
      "style": "dashed"
    },
    {
      "from": "events",
      "to": "dispatch",
      "label": "Consumes",
      "technology": "Kafka",
      "style": "dashed"
    },
    {
      "from": "events",
      "to": "notify",
      "label": "Consumes",
      "technology": "Kafka",
      "style": "dashed"
    },
    {
      "from": "dispatch",
      "to": "db",
      "label": "Reads / writes",
      "technology": "SQL"
    },
    {
      "from": "dispatch",
      "to": "routing",
      "label": "Requests a sequenced route from",
      "technology": "gRPC"
    },
    {
      "from": "dispatch",
      "to": "partners",
      "label": "Hands off out-of-area parcels to",
      "technology": "HTTPS"
    },
    {
      "from": "api",
      "to": "db",
      "label": "Reads",
      "technology": "SQL"
    },
    {
      "from": "scans",
      "to": "db",
      "label": "Writes",
      "technology": "SQL"
    },
    {
      "from": "notify",
      "to": "sms",
      "label": "Sends SMS through",
      "technology": "HTTPS"
    }
  ],
  "cards": [
    {
      "title": "Ownership",
      "tone": "info",
      "items": [
        "Merchant-facing: platform team",
        "Dispatch, routing and scans: network team",
        "Handheld app: field systems team"
      ]
    },
    {
      "title": "Watch out",
      "tone": "warning",
      "items": [
        "Scan ingest must stay available when depots are busiest; it is the only write path for parcel movement",
        "Handhelds go offline for hours, so scans arrive late and out of order"
      ]
    }
  ]
}
