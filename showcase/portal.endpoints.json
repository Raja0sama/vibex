{
  "schema_version": 1,
  "diagram_type": "endpoints",
  "meta": {
    "title": "Merchant portal API",
    "api_kind": "graphql",
    "subtitle": "GraphQL, because a merchant dashboard wants a shipment, its parcels and their scans in one round trip",
    "id": "portal.endpoints",
    "repository": {
      "url": "https://github.com/example/relay",
      "revision": "main"
    }
  },
  "groups": [
    {
      "id": "queries",
      "label": "Queries"
    },
    {
      "id": "mutations",
      "label": "Mutations"
    },
    {
      "id": "subscriptions",
      "label": "Subscriptions"
    }
  ],
  "endpoints": [
    {
      "id": "query-shipment",
      "group": "queries",
      "method": "QUERY",
      "path": "shipment(id: ID!)",
      "summary": "One shipment with its parcels and their current state",
      "response": "Shipment",
      "params": [
        {
          "name": "id",
          "in": "arg",
          "type": "ID!",
          "required": true
        }
      ]
    },
    {
      "id": "query-shipments",
      "group": "queries",
      "method": "QUERY",
      "path": "shipments(status: ParcelStatus, bookedSince: DateTime, first: Int, after: String)",
      "summary": "The calling merchant's shipments, newest first",
      "response": "ShipmentConnection!",
      "params": [
        {
          "name": "status",
          "in": "arg",
          "type": "ParcelStatus"
        },
        {
          "name": "bookedSince",
          "in": "arg",
          "type": "DateTime"
        },
        {
          "name": "first",
          "in": "arg",
          "type": "Int"
        },
        {
          "name": "after",
          "in": "arg",
          "type": "String"
        }
      ]
    },
    {
      "id": "query-parcel",
      "group": "queries",
      "method": "QUERY",
      "path": "parcel(trackingNumber: String!)",
      "summary": "Everything known about one parcel, by its tracking number",
      "response": "Parcel",
      "params": [
        {
          "name": "trackingNumber",
          "in": "arg",
          "type": "String!",
          "required": true
        }
      ]
    },
    {
      "id": "query-depots",
      "group": "queries",
      "method": "QUERY",
      "path": "depots",
      "summary": "Depots and the postcodes they serve",
      "response": "[Depot!]!"
    },
    {
      "id": "mutation-bookShipment",
      "group": "mutations",
      "method": "MUTATION",
      "path": "bookShipment(input: BookShipmentInput!)",
      "summary": "Book a shipment and mint a tracking number per parcel",
      "response": "BookShipmentPayload!",
      "params": [
        {
          "name": "input",
          "in": "arg",
          "type": "BookShipmentInput!",
          "required": true
        }
      ]
    },
    {
      "id": "mutation-cancelShipment",
      "group": "mutations",
      "method": "MUTATION",
      "path": "cancelShipment(id: ID!)",
      "summary": "Cancel before collection; fails once any parcel has been scanned",
      "response": "CancelShipmentPayload!",
      "params": [
        {
          "name": "id",
          "in": "arg",
          "type": "ID!",
          "required": true
        }
      ]
    },
    {
      "id": "mutation-sequenceRoute",
      "group": "mutations",
      "method": "MUTATION",
      "path": "sequenceRoute(routeId: ID!)",
      "summary": "Ask the routing engine to sequence a route's stops",
      "response": "Route!",
      "params": [
        {
          "name": "routeId",
          "in": "arg",
          "type": "ID!",
          "required": true
        }
      ]
    },
    {
      "id": "subscription-parcelScanned",
      "group": "subscriptions",
      "method": "SUBSCRIPTION",
      "path": "parcelScanned(shipmentId: ID)",
      "summary": "Every scan on the calling merchant's parcels, as it is ingested",
      "response": "Scan!",
      "params": [
        {
          "name": "shipmentId",
          "in": "arg",
          "type": "ID"
        }
      ]
    }
  ],
