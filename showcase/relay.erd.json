{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "id": "relay.erd",
    "title": "Relay data model",
    "subtitle": "What a parcel is, where it has been, and who was meant to receive it",
    "repository": { "url": "https://github.com/example/relay", "revision": "main" }
  },
  "groups": [
    { "id": "booking", "label": "Booking", "entities": ["merchant", "shipment", "parcel", "recipient", "address"] },
    { "id": "network", "label": "Network", "entities": ["depot", "driver", "route", "stop"] },
    { "id": "movement", "label": "Movement", "entities": ["scan", "delivery_attempt", "parcel_status", "scan_type"] }
  ],
  "entities": [
    {
      "id": "merchant", "name": "merchants", "description": "Businesses that book shipments",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "name", "type": "text" },
        { "name": "account_ref", "type": "citext", "unique": true },
        { "name": "created_at", "type": "timestamptz", "default": "now()" }
      ],
      "sources": [{ "path": "migrations/001_merchants.sql", "line": 1 }]
    },
    {
      "id": "shipment", "name": "shipments", "description": "One booking, which may contain several parcels",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "merchant_id", "type": "uuid" },
        { "name": "reference", "type": "text", "nullable": true },
        { "name": "service_level", "type": "service_level" },
        { "name": "recipient_id", "type": "uuid" },
        { "name": "destination_id", "type": "uuid" },
        { "name": "booked_at", "type": "timestamptz" }
      ],
      "sources": [{ "path": "migrations/002_shipments.sql", "line": 1 }]
    },
    {
      "id": "parcel", "name": "parcels", "description": "The physical thing. One row per barcode.",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "shipment_id", "type": "uuid" },
        { "name": "tracking_number", "type": "text", "unique": true },
        { "name": "status", "type": "parcel_status" },
        { "name": "weight_grams", "type": "int" },
        { "name": "attempts", "type": "int", "default": "0" },
        { "name": "current_depot_id", "type": "uuid", "nullable": true }
      ],
      "sources": [{ "path": "migrations/003_parcels.sql", "line": 1 }]
    },
    {
      "id": "recipient", "name": "recipients", "description": "Who the parcel is for. Deliberately not an account.",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "name", "type": "text" },
        { "name": "phone", "type": "text", "nullable": true },
        { "name": "email", "type": "citext", "nullable": true }
      ]
    },
    {
      "id": "address", "name": "addresses", "description": "Validated and geocoded before a shipment is accepted",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "line1", "type": "text" },
        { "name": "line2", "type": "text", "nullable": true },
        { "name": "city", "type": "text" },
        { "name": "postcode", "type": "text" },
        { "name": "country", "type": "char(2)" },
        { "name": "latitude", "type": "numeric", "nullable": true },
        { "name": "longitude", "type": "numeric", "nullable": true },
        { "name": "validated_at", "type": "timestamptz", "nullable": true }
      ]
    },

    {
      "id": "depot", "name": "depots", "description": "A sorting site. Every parcel passes through at least one.",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "code", "type": "text", "unique": true },
        { "name": "name", "type": "text" },
        { "name": "address_id", "type": "uuid" }
      ]
    },
    {
      "id": "driver", "name": "drivers", "description": "Couriers, each based at one depot",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "depot_id", "type": "uuid" },
        { "name": "name", "type": "text" },
        { "name": "licence_ref", "type": "text", "unique": true }
      ]
    },
    {
      "id": "route", "name": "routes", "description": "One driver, one van, one day",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "depot_id", "type": "uuid" },
        { "name": "driver_id", "type": "uuid", "nullable": true },
        { "name": "service_date", "type": "date" },
        { "name": "sequenced_at", "type": "timestamptz", "nullable": true }
      ]
    },
    {
      "id": "stop", "name": "stops", "description": "One parcel's place in a route, with the window promised to the recipient",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "route_id", "type": "uuid" },
        { "name": "parcel_id", "type": "uuid" },
        { "name": "sequence", "type": "int" },
        { "name": "window_start", "type": "timestamptz" },
        { "name": "window_end", "type": "timestamptz" }
      ]
    },

    {
      "id": "scan", "name": "scans", "description": "Append-only. Every barcode read, in the order it happened, not the order it arrived.",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "parcel_id", "type": "uuid" },
        { "name": "type", "type": "scan_type" },
        { "name": "depot_id", "type": "uuid", "nullable": true },
        { "name": "driver_id", "type": "uuid", "nullable": true },
        { "name": "device_id", "type": "text" },
        { "name": "scanned_at", "type": "timestamptz" },
        { "name": "received_at", "type": "timestamptz", "default": "now()" },
        { "name": "idempotency_key", "type": "text", "unique": true }
      ],
      "sources": [{ "path": "migrations/010_scans.sql", "line": 1 }]
    },
    {
      "id": "delivery_attempt", "name": "delivery_attempts", "description": "Why a parcel came back on the van",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "parcel_id", "type": "uuid" },
        { "name": "stop_id", "type": "uuid", "nullable": true },
        { "name": "outcome", "type": "text" },
        { "name": "attempted_at", "type": "timestamptz" },
        { "name": "photo_url", "type": "text", "nullable": true }
      ]
    },
    {
      "id": "parcel_status", "name": "parcel_status", "kind": "enum",
      "values": ["created", "collected", "at_depot", "in_transit", "out_for_delivery", "delivered", "attempt_failed", "awaiting_instruction", "returning", "returned", "lost", "cancelled"]
    },
    {
      "id": "scan_type", "name": "scan_type", "kind": "enum",
      "values": ["collection", "depot_inbound", "depot_outbound", "vehicle_load", "delivery", "attempt_failed", "return"]
    }
  ],
  "relationships": [
    { "id": "shipment-merchant", "from": "shipment", "to": "merchant", "from_column": "merchant_id", "to_column": "id", "label": "booked by", "on_delete": "restrict" },
    { "id": "shipment-recipient", "from": "shipment", "to": "recipient", "from_column": "recipient_id", "to_column": "id", "label": "addressed to" },
    { "id": "shipment-address", "from": "shipment", "to": "address", "from_column": "destination_id", "to_column": "id", "label": "delivers to" },
    { "id": "parcel-shipment", "from": "parcel", "to": "shipment", "from_column": "shipment_id", "to_column": "id", "label": "part of", "on_delete": "cascade" },
    { "id": "parcel-depot", "from": "parcel", "to": "depot", "from_column": "current_depot_id", "to_column": "id", "to_cardinality": "zero-or-one", "label": "currently at" },
    { "id": "depot-address", "from": "depot", "to": "address", "from_column": "address_id", "to_column": "id", "label": "sited at" },
    { "id": "driver-depot", "from": "driver", "to": "depot", "from_column": "depot_id", "to_column": "id", "label": "based at" },
    { "id": "route-depot", "from": "route", "to": "depot", "from_column": "depot_id", "to_column": "id", "label": "leaves from" },
    { "id": "route-driver", "from": "route", "to": "driver", "from_column": "driver_id", "to_column": "id", "to_cardinality": "zero-or-one", "label": "driven by" },
    { "id": "stop-route", "from": "stop", "to": "route", "from_column": "route_id", "to_column": "id", "label": "on", "on_delete": "cascade" },
    { "id": "stop-parcel", "from": "stop", "to": "parcel", "from_column": "parcel_id", "to_column": "id", "label": "delivers" },
    { "id": "scan-parcel", "from": "scan", "to": "parcel", "from_column": "parcel_id", "to_column": "id", "label": "records", "on_delete": "restrict" },
    { "id": "attempt-parcel", "from": "delivery_attempt", "to": "parcel", "from_column": "parcel_id", "to_column": "id", "label": "against" }
  ],
  "cards": [
    { "title": "Conventions", "tone": "info", "items": ["All ids are uuid v7, so they sort by creation time", "Weights are integer grams; there are no floats anywhere in this schema", "Timestamps are timestamptz in UTC"] },
    { "title": "Watch out", "tone": "warning", "items": ["scans is append-only and never updated — corrections are new rows", "scanned_at is device time and can be wrong; received_at is server time and cannot", "parcels.attempts is denormalised from delivery_attempts for the route planner"] }
  ]
}
