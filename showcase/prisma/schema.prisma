// Billing runs on its own database, separate from the parcel network, because
// a finance migration must never be able to stop a van.
//
// vibex import prisma showcase/prisma/schema.prisma showcase/billing.erd.json

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("BILLING_DATABASE_URL")
}

model Account {
  id         String    @id @default(uuid())
  merchantId String    @unique @map("merchant_id")
  name       String
  currency   String    @db.Char(3)
  termsDays  Int       @default(30) @map("terms_days")
  createdAt  DateTime  @default(now()) @map("created_at")
  invoices   Invoice[]
  rateCards  RateCard[]

  @@map("accounts")
}

model Invoice {
  id          String        @id @default(uuid())
  accountId   String        @map("account_id")
  account     Account       @relation(fields: [accountId], references: [id])
  number      String        @unique
  status      InvoiceStatus @default(draft)
  issuedAt    DateTime?     @map("issued_at")
  dueAt       DateTime?     @map("due_at")
  totalMinor  Int           @map("total_minor")
  lines       InvoiceLine[]
  payments    Payment[]

  @@map("invoices")
}

model InvoiceLine {
  id           String  @id @default(uuid())
  invoiceId    String  @map("invoice_id")
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  parcelId     String  @map("parcel_id")
  description  String
  amountMinor  Int     @map("amount_minor")
  surcharge    Boolean @default(false)

  @@map("invoice_lines")
}

model Payment {
  id         String   @id @default(uuid())
  invoiceId  String   @map("invoice_id")
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  reference  String   @unique
  amountMinor Int     @map("amount_minor")
  receivedAt DateTime @map("received_at")

  @@map("payments")
}

model RateCard {
  id        String   @id @default(uuid())
  accountId String   @map("account_id")
  account   Account  @relation(fields: [accountId], references: [id])
  service   String
  perKgMinor Int     @map("per_kg_minor")
  validFrom DateTime @map("valid_from")
  validTo   DateTime? @map("valid_to")

  @@map("rate_cards")
}

enum InvoiceStatus {
  draft
  issued
  part_paid
  paid
  overdue
  written_off
}
