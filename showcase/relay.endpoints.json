{
  "schema_version": 1,
  "diagram_type": "endpoints",
  "meta": {
    "id": "relay.endpoints",
    "title": "Relay API",
    "subtitle": "What merchants call, what recipients call without an account, and what handhelds push",
    "repository": { "url": "https://github.com/example/relay", "revision": "main" }
  },
  "groups": [
    { "id": "shipments", "label": "Shipments", "description": "Merchant booking and cancellation", "sources": [{ "path": "src/shipments/shipments.handler.go" }] },
    { "id": "tracking", "label": "Tracking", "description": "Public, unauthenticated, one parcel at a time", "sources": [{ "path": "src/tracking/tracking.handler.go" }] },
    { "id": "field", "label": "Field devices", "description": "Handheld uploads. Batched, idempotent, often late." },
    { "id": "network", "label": "Network operations", "description": "Depot and route management for ops staff" },
    { "id": "events", "label": "Published events", "description": "What Relay emits for merchants to subscribe to" }
  ],
  "endpoints": [
    { "id": "book-shipment", "group": "shipments", "method": "POST", "path": "/v1/shipments", "summary": "Book a shipment and mint a tracking number per parcel", "auth": "api-key", "request": "CreateShipmentInput", "response": "Shipment", "status": [201, 400, 402, 422], "entities": ["shipment", "parcel", "address"], "sources": [{ "path": "src/shipments/shipments.handler.go", "line": 44 }] },
    { "id": "list-shipments", "group": "shipments", "method": "GET", "path": "/v1/shipments", "summary": "List the calling merchant's shipments, newest first", "auth": "api-key", "response": "Shipment[]", "status": [200, 401], "params": [{ "name": "status", "in": "query", "type": "ParcelStatus" }, { "name": "booked_since", "in": "query", "type": "date" }, { "name": "cursor", "in": "query", "type": "string" }], "entities": ["shipment"] },
    { "id": "get-shipment", "group": "shipments", "method": "GET", "path": "/v1/shipments/{id}", "summary": "One shipment with all of its parcels", "auth": "api-key", "response": "Shipment", "status": [200, 404], "params": [{ "name": "id", "in": "path", "required": true, "type": "uuid" }], "entities": ["shipment", "parcel"] },
    { "id": "cancel-shipment", "group": "shipments", "method": "POST", "path": "/v1/shipments/{id}/cancel", "summary": "Cancel before collection; fails once any parcel has been scanned", "auth": "api-key", "response": "Shipment", "status": [200, 404, 409], "params": [{ "name": "id", "in": "path", "required": true, "type": "uuid" }], "entities": ["shipment", "parcel"], "sources": [{ "path": "src/shipments/shipments.handler.go", "line": 118 }] },
    { "id": "label", "group": "shipments", "method": "GET", "path": "/v1/parcels/{id}/label", "summary": "The printable label as a PDF", "auth": "api-key", "response": "application/pdf", "status": [200, 404], "params": [{ "name": "id", "in": "path", "required": true, "type": "uuid" }], "entities": ["parcel"] },

    { "id": "track", "group": "tracking", "method": "GET", "path": "/v1/track/{tracking_number}", "summary": "Public tracking history for one parcel", "auth": false, "response": "TrackingEvent[]", "status": [200, 404, 429], "params": [{ "name": "tracking_number", "in": "path", "required": true, "type": "string" }], "entities": ["parcel", "scan"], "sources": [{ "path": "src/tracking/tracking.handler.go", "line": 31 }] },
    { "id": "reschedule", "group": "tracking", "method": "POST", "path": "/v1/track/{tracking_number}/reschedule", "summary": "Pick another delivery day", "auth": "otp", "request": "RescheduleInput", "response": "TrackingEvent", "status": [200, 409, 410], "params": [{ "name": "tracking_number", "in": "path", "required": true, "type": "string" }], "entities": ["parcel", "stop"] },
    { "id": "redirect", "group": "tracking", "method": "POST", "path": "/v1/track/{tracking_number}/redirect", "summary": "Send it to a neighbour or a safe place instead", "auth": "otp", "request": "RedirectInput", "response": "TrackingEvent", "status": [200, 409, 410], "params": [{ "name": "tracking_number", "in": "path", "required": true, "type": "string" }], "entities": ["parcel", "address"] },

    { "id": "push-scans", "group": "field", "method": "POST", "path": "/v1/scans", "summary": "Upload a batch of scans taken while offline", "auth": "mtls", "request": "ScanBatch", "response": "ScanBatchResult", "status": [202, 207, 401], "params": [{ "name": "Idempotency-Key", "in": "header", "required": true, "type": "string" }], "entities": ["scan", "parcel"], "sources": [{ "path": "src/scans/ingest.go", "line": 58 }] },
    { "id": "record-attempt", "group": "field", "method": "POST", "path": "/v1/attempts", "summary": "Record a failed delivery attempt with a reason and a photo", "auth": "mtls", "request": "AttemptInput", "response": "TrackingEvent", "status": [201, 401, 422], "entities": ["delivery_attempt", "parcel"] },
    { "id": "manifest", "group": "field", "method": "GET", "path": "/v1/routes/{id}/manifest", "summary": "Today's sequenced stops for a driver, cacheable offline", "auth": "mtls", "response": "Stop[]", "status": [200, 404], "params": [{ "name": "id", "in": "path", "required": true, "type": "uuid" }], "entities": ["route", "stop", "parcel"] },

    { "id": "list-depots", "group": "network", "method": "GET", "path": "/v1/depots", "summary": "Every depot and the postcodes it serves", "auth": "bearer", "response": "Depot[]", "status": [200], "entities": ["depot"] },
    { "id": "sequence-route", "group": "network", "method": "POST", "path": "/v1/routes/{id}/sequence", "summary": "Ask the routing engine to order the stops", "auth": "bearer", "response": "Route", "status": [200, 409, 503], "params": [{ "name": "id", "in": "path", "required": true, "type": "uuid" }], "entities": ["route", "stop"] },
    { "id": "old-track", "group": "tracking", "method": "GET", "path": "/track/{tracking_number}", "summary": "Unversioned tracking; use /v1/track", "auth": false, "response": "TrackingEvent[]", "status": [200, 404], "deprecated": true, "params": [{ "name": "tracking_number", "in": "path", "required": true, "type": "string" }], "entities": ["parcel"] },

    { "id": "ev-delivered", "group": "events", "method": "EVENT", "path": "parcel.delivered", "summary": "Published when a delivery scan lands", "response": "ParcelDeliveredEvent", "entities": ["parcel"] },
    { "id": "ev-attempt", "group": "events", "method": "EVENT", "path": "parcel.attempt-failed", "summary": "Published when a courier records a failed attempt", "response": "ParcelAttemptEvent", "entities": ["parcel", "delivery_attempt"] },
    { "id": "ev-exception", "group": "events", "method": "EVENT", "path": "parcel.exception", "summary": "Published when a parcel is marked lost or begins returning", "response": "ParcelExceptionEvent", "entities": ["parcel"] }
  ],
  "types": [
    { "id": "CreateShipmentInput", "name": "CreateShipmentInput", "kind": "input", "fields": [{ "name": "reference", "type": "string" }, { "name": "service_level", "type": "ServiceLevel", "required": true }, { "name": "recipient", "type": "RecipientInput", "required": true }, { "name": "destination", "type": "AddressInput", "required": true }, { "name": "parcels", "type": "ParcelInput[]", "required": true }] },
    { "id": "Shipment", "name": "Shipment", "fields": [{ "name": "id", "type": "uuid", "required": true }, { "name": "reference", "type": "string" }, { "name": "service_level", "type": "ServiceLevel", "required": true }, { "name": "parcels", "type": "Parcel[]", "required": true }, { "name": "booked_at", "type": "datetime", "required": true }] },
    { "id": "Parcel", "name": "Parcel", "fields": [{ "name": "id", "type": "uuid", "required": true }, { "name": "tracking_number", "type": "string", "required": true }, { "name": "status", "type": "ParcelStatus", "required": true }, { "name": "attempts", "type": "int", "required": true }, { "name": "weight_grams", "type": "int", "required": true }] },
    { "id": "TrackingEvent", "name": "TrackingEvent", "fields": [{ "name": "type", "type": "ScanType", "required": true }, { "name": "at", "type": "datetime", "required": true }, { "name": "depot", "type": "string" }, { "name": "message", "type": "string", "required": true }] },
    { "id": "ScanBatch", "name": "ScanBatch", "kind": "input", "fields": [{ "name": "device_id", "type": "string", "required": true }, { "name": "scans", "type": "ScanInput[]", "required": true }] },
    { "id": "RescheduleInput", "name": "RescheduleInput", "kind": "input", "fields": [{ "name": "service_date", "type": "date", "required": true }, { "name": "otp", "type": "string", "required": true }] },
    { "id": "ParcelStatus", "name": "ParcelStatus", "kind": "enum", "fields": [{ "name": "created" }, { "name": "collected" }, { "name": "at_depot" }, { "name": "in_transit" }, { "name": "out_for_delivery" }, { "name": "delivered" }, { "name": "attempt_failed" }, { "name": "awaiting_instruction" }, { "name": "returning" }, { "name": "returned" }, { "name": "lost" }, { "name": "cancelled" }] },
    { "id": "ServiceLevel", "name": "ServiceLevel", "kind": "enum", "fields": [{ "name": "next_day" }, { "name": "two_day" }, { "name": "economy" }] }
  ],
  "cards": [
    { "title": "Auth is per audience", "tone": "info", "items": ["Merchants: a long-lived API key scoped to one merchant", "Recipients: no account — a one-time code sent to the phone on the shipment", "Handhelds: client certificates, rotated per device"] }
  ]
}
